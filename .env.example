# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a un repositorio publico.

# Cadena de conexion de tu base de datos Postgres (ej. Neon, Supabase, Railway)
DATABASE_URL="postgresql://usuario:contrasena@host.neon.tech/sonrisadigital?sslmode=require"

# Puerto del servidor
PORT=3000

# Clave secreta para firmar tokens JWT del panel admin (usa una cadena larga y aleatoria)
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Proveedor de WhatsApp: "twilio_sandbox" (mensajes reales via sandbox) o "simulado"
WHATSAPP_PROVIDER="twilio_sandbox"

# Credenciales de Twilio (https://console.twilio.com) - solo si WHATSAPP_PROVIDER=twilio_sandbox
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Numero de WhatsApp del Sandbox de Twilio (formato: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Numero de WhatsApp del personal administrativo que recibe alertas (formato: whatsapp:+57XXXXXXXXXX)
ADMIN_WHATSAPP_NUMBER=""

# API key de Google Maps (dejar vacio para usar el embed gratuito sin key)
GOOGLE_MAPS_API_KEY=""

# Notificaciones push (Web Push / VAPID). Generadas con: npx web-push generate-vapid-keys
# La privada es un secreto: nunca subirla al repositorio.
VAPID_PUBLIC_KEY="pega-aqui-la-clave-publica"
VAPID_PRIVATE_KEY="pega-aqui-la-clave-privada"
VAPID_SUBJECT="mailto:contacto@sonrisadigital.com"

# Dominio para Face ID (WebAuthn). En local dejar asi; en produccion poner el
# dominio real, ej. WEBAUTHN_RP_ID="sonrisadigital.com"
WEBAUTHN_RP_NAME="Sonrisa Digital"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# Origenes permitidos para CORS (separados por coma). Vacio = abierto (solo desarrollo)
CORS_ORIGIN=""
# Poner en "true" cuando la app corra detras de un proxy (Render, Railway, Nginx)
TRUST_PROXY="false"

# --- WhatsApp Cloud API (Meta) ---
# WhatsApp -> Configuracion de la API, en developers.facebook.com
# El token temporal caduca en 24 h; el permanente se genera con un usuario del sistema.
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_API_VERSION="v20.0"
# Token que tu inventas; se usa para validar el webhook con Meta.
META_WEBHOOK_VERIFY_TOKEN=""
